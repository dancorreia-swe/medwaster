EXPO_PUBLIC_SERVER_URL=http://localhost:4000

# Sentry (optional, off when the DSN is unset). Inlined at build time.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Source map upload for release builds; skipped when the token is unset.
# Never commit a real token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
