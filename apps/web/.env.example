VITE_SERVER_URL=
# Sentry (optional, off when the DSN is unset). In Docker the DSN/environment
# are injected at container start via env-config.js, like VITE_SERVER_URL.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time only: source map upload. Skipped unless all three are set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
